# ====================================================
# FinGuard AI — Environment Configuration Template
# ====================================================

# Application Environment (development | production)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Model Version Identifier
MODEL_VERSION=xgb-v1.0

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Batch & File Limits
MAX_BATCH_ROWS=10000
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8080"]

# Frontend Configuration (for Vite builds)
VITE_API_BASE_URL=http://localhost:8000
